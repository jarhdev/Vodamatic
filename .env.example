# --- Negocio ---
NEGOCIO_NOMBRE="Café La Esquina"
# cafeteria | bodegon | distribuidor | peluqueria | panaderia | general
NEGOCIO_RUBRO=cafeteria
# Tasa BCV con la que el negocio convierte sus precios en USD a Bs: usd | eur
TASA_REFERENCIA=usd

# --- Sesión ---
# Cadena larga y aleatoria (openssl rand -hex 32). Obligatoria en producción.
SESSION_SECRET=
# Clave para que n8n / bots llamen a la API con el header X-Api-Key (opcional).
API_KEY=

# --- Google Sheets (si falta, la app arranca en MODO DEMO con datos en memoria) ---
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
# Pegar la private_key del JSON de la cuenta de servicio, con los \n tal cual.
GOOGLE_PRIVATE_KEY=
# Carpeta (en una Unidad compartida) donde guardar fotos de facturas y capturas (opcional).
GOOGLE_DRIVE_FOLDER_ID=

# --- Lectura de facturas y capturas con IA ---
ANTHROPIC_API_KEY=

# Tasa de respaldo si la API de tasas no responde y no hay ninguna guardada.
TASA_USD_RESPALDO=
TASA_EUR_RESPALDO=

# --- Bot de Telegram (gratis) ---
# Token que da @BotFather al crear el bot con /newbot
TELEGRAM_BOT_TOKEN=
# Clave al azar (letras, números, _ o -) para verificar que los mensajes vienen de Telegram
TELEGRAM_WEBHOOK_SECRET=
